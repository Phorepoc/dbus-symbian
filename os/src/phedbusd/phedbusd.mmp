TARGET			phedbusd.exe
TARGETTYPE		exe
UID				0x1000007a 0xE701578D
CAPABILITY		all -tcb
VENDORID		0
EPOCSTACKSIZE	0x100000
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phedbusd.cpp
SOURCE			phedbusd_proc.cpp
SOURCEPATH		../phedbus
SOURCE			phedbus_random.cpp
LIBRARY			euser.lib libc.lib libm.lib libpthread.lib
SMPSAFE
